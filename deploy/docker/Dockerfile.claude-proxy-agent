FROM golang:1.26-alpine AS builder

RUN apk add --no-cache git

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -o /claude-proxy-agent ./examples/claude-proxy-agent

FROM node:22-alpine

RUN apk add --no-cache ca-certificates tzdata

RUN npm install -g @anthropic-ai/claude-code

RUN addgroup -S agent && adduser -S agent -G agent
WORKDIR /home/agent

COPY --from=builder /claude-proxy-agent /usr/local/bin/claude-proxy-agent

USER agent

ENTRYPOINT ["claude-proxy-agent"]
