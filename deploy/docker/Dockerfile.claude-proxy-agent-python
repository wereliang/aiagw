FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*

RUN addgroup --system agent && adduser --system --ingroup agent agent

WORKDIR /app

COPY examples/claude-proxy-agent-python/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY api/proto/agent.proto /tmp/proto/agent.proto
RUN python -m grpc_tools.protoc \
    -I /tmp/proto \
    --python_out=/app \
    --grpc_python_out=/app \
    /tmp/proto/agent.proto

COPY examples/claude-proxy-agent-python/main.py .

USER agent
WORKDIR /home/agent

ENTRYPOINT ["python", "/app/main.py"]
